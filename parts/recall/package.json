{
  "name": "dsh-message-recall-wm",
  "version": "2.6.1+wm.6",
  "description": "[WM fork · 新增助手回复编辑] DSH Web内目前最无感的消息撤回、重编辑插件，原版体验，兼容性强，功能简单可开关，设置丰富，现代化轻量ui框架。The most seamless message recall & re-edit plugin for DSH Web — native experience, strong compatibility, simple toggles, rich settings, modern lightweight UI. DSH Web で最もシームレスなメッセージ撤回・再編集プラグイン——ネイティブ体験、高い互換性、シンプルなトグル、充実した設定、モダンで軽量な UI。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "displayName": "MessageRecall WM",
    "displayDescription": "简单易用的撤回重编辑（WM 分叉：新增「编辑我的回复」）",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "sessions",
        "workspaces",
        "conversation",
        "modelDirectories"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "client-plugin",
    "ui",
    "plugin",
    "edit",
    "rewrite",
    "bubble-edit",
    "recall",
    "undo",
    "rollback",
    "version-pager",
    "撤回",
    "气泡编辑",
    "重编辑",
    "取り消し",
    "バブル編集",
    "編集",
    "i18n",
    "internationalization",
    "multilingual",
    "localization",
    "zh",
    "en",
    "ja"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node tests/wm-assistant-edit.test.mjs && node tests/purge-resurrected-queue.test.mjs && node tests/purge-queue-host.test.mjs",
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jipcon/DSH-plugins.git",
    "directory": "dsh-message-recall-wm"
  },
  "homepage": "https://github.com/Jipcon/DSH-plugins/tree/main/dsh-message-recall#readme",
  "bugs": {
    "url": "https://github.com/Jipcon/DSH-plugins/issues"
  }
}
